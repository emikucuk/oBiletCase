@model oBiletCase.Web.Models.Journeys.JourneySearchSummaryViewModel
@{
    ViewData["Title"] = Localizer["JourneysComingSoonTitle"];
}

<section class="summary-card">
    <p class="summary-card__kicker">@Localizer["SearchEyebrow"]</p>
    <h1>@Localizer["JourneysComingSoonTitle"]</h1>
    <p class="summary-card__lede">@Localizer["JourneysComingSoonBody"]</p>

    <div class="route">
        <div class="route__point">
            <dl>
                <dt>@Localizer["OriginSummaryLabel"]</dt>
                <dd>@Model.OriginName</dd>
            </dl>
        </div>
        <div class="route__line" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="route__point route__point--end">
            <dl>
                <dt>@Localizer["DestinationSummaryLabel"]</dt>
                <dd>@Model.DestinationName</dd>
            </dl>
        </div>
    </div>

    <div class="route-meta">
        <span class="route-meta__item">@Localizer["DepartureDateSummaryLabel"]: @Model.DepartureDate.ToString("d")</span>
    </div>

    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">@Localizer["BackToSearch"]</a>
</section>
