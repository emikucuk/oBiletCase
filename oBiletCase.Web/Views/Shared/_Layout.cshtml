@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["AppName"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet"> 
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/search-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/recent-searches.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/autocomplete.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/datepicker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/summary-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/journey-results.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/rating.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@Localizer["SkipToContent"]</a>
    <header class="site-header">
        <div class="container site-header__bar">
            <a class="site-header__brand" asp-controller="Home" asp-action="Index">
                <span class="site-header__mark" aria-hidden="true">o</span>
                @Localizer["AppName"]
            </a>
            <nav class="language-switch" aria-label="@Localizer["LanguageSwitchLabel"]">
                <a class="language-switch__link"
                   aria-current="@(currentCulture.StartsWith("tr") ? "true" : null)"
                   asp-controller="Culture" asp-action="Set" asp-route-culture="tr-TR" asp-route-returnUrl="@returnUrl">TR</a>
                <a class="language-switch__link"
                   aria-current="@(currentCulture.StartsWith("en") ? "true" : null)"
                   asp-controller="Culture" asp-action="Set" asp-route-culture="en-US" asp-route-returnUrl="@returnUrl">EN</a>
            </nav>
        </div>
    </header>
    <main id="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <footer class="site-footer">
        <div class="container site-footer__inner">
            <span>&copy; @DateTime.Now.Year @Localizer["AppName"]</span>
            <span>@Localizer["FooterTagline"]</span>
        </div>
    </footer>
    <script src="~/js/location-autocomplete.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
