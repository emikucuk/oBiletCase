@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["ErrorTitle"];
}

<section class="summary-card">
    <p class="summary-card__kicker">@Localizer["ErrorKicker"]</p>
    <h1>@Localizer["ErrorTitle"]</h1>
    <p class="summary-card__lede">@Localizer["ErrorBody"]</p>

    @if (Model.ShowRequestId)
    {
        <p class="route-meta__item">@Localizer["RequestIdLabel"]: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">@Localizer["BackToSearch"]</a>
</section>
