@model oBiletCase.Web.Models.Journeys.JourneySearchViewModel
@{
    ViewData["Title"] = Localizer["SearchTitle"];
    var todayIso = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var isFresh = ViewData["IsFreshSearch"] as bool? ?? false;
    var originInvalid = ViewData.ModelState[nameof(Model.OriginId)]?.Errors.Count > 0;
    var destinationInvalid = ViewData.ModelState[nameof(Model.DestinationId)]?.Errors.Count > 0;
    var dateInvalid = ViewData.ModelState[nameof(Model.DepartureDate)]?.Errors.Count > 0;
}

<section class="hero">
    <p class="hero__eyebrow">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        @Localizer["SearchEyebrow"]
    </p>
    <h1 class="hero__title">
        @Localizer["SearchTitle"].
        <br />
        <em>@Localizer["SearchAccent"]</em>
    </h1>
    <p class="hero__lede">@Localizer["SearchLede"]</p>
</section>

<section class="search-panel">
    <form id="journeySearchForm" asp-controller="Home" asp-action="Index" method="post" class="search-form"
          data-search-form
          data-locations-search-url="@Url.Action("Search", "Locations")"
          data-fresh="@(isFresh ? "true" : "false")">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary" role="alert">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="search-bar">
            <div class="search-bar__field @(originInvalid ? "is-invalid" : null)">
                <label class="search-bar__label" for="originInput">@Localizer["OriginLabel"]</label>
                <div class="search-bar__control">
                    <svg class="search-bar__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 21s6.5-5.8 6.5-10.5a6.5 6.5 0 1 0-13 0C5.5 15.2 12 21 12 21z"
                              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="12" cy="10.5" r="2.25" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    <div class="autocomplete" id="originAutocomplete" data-autocomplete-root="origin"
                         data-empty-text="@Localizer["NoLocationResults"]"
                         data-loading-text="@Localizer["SearchLocationLoading"]"
                         data-error-text="@Localizer["SearchLocationError"]">
                        <input type="text" id="originInput" class="autocomplete__input" data-autocomplete-input
                               role="combobox" aria-expanded="false" aria-autocomplete="list"
                               aria-controls="originAutocomplete-list"
                               autocomplete="off" spellcheck="false" autocapitalize="off" autocorrect="off"
                               placeholder="@Localizer["OriginPlaceholder"]"
                               value="@Model.OriginName" />
                        <button type="button" class="autocomplete__clear" data-autocomplete-clear hidden
                                aria-label="@Localizer["ClearLocationLabel"]">&times;</button>
                        <input type="hidden" asp-for="OriginId" data-autocomplete-id />
                        <input type="hidden" asp-for="OriginName" data-autocomplete-name />
                        <ul id="originAutocomplete-list" class="autocomplete__panel" role="listbox"
                            data-autocomplete-list hidden></ul>
                    </div>
                </div>
                <span asp-validation-for="OriginId" class="field-error"></span>
            </div>

            <button type="button" class="btn-icon search-bar__swap" data-swap aria-label="@Localizer["SwapLocationsLabel"]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M8 7h10M15 4l3 3-3 3M16 17H6M9 14l-3 3 3 3"
                          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <div class="search-bar__field @(destinationInvalid ? "is-invalid" : null)">
                <label class="search-bar__label" for="destinationInput">@Localizer["DestinationLabel"]</label>
                <div class="search-bar__control">
                    <svg class="search-bar__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="7.25" stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="12" cy="12" r="2.1" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    <div class="autocomplete" id="destinationAutocomplete" data-autocomplete-root="destination"
                         data-empty-text="@Localizer["NoLocationResults"]"
                         data-loading-text="@Localizer["SearchLocationLoading"]"
                         data-error-text="@Localizer["SearchLocationError"]">
                        <input type="text" id="destinationInput" class="autocomplete__input" data-autocomplete-input
                               role="combobox" aria-expanded="false" aria-autocomplete="list"
                               aria-controls="destinationAutocomplete-list"
                               autocomplete="off" spellcheck="false" autocapitalize="off" autocorrect="off"
                               placeholder="@Localizer["DestinationPlaceholder"]"
                               value="@Model.DestinationName" />
                        <button type="button" class="autocomplete__clear" data-autocomplete-clear hidden
                                aria-label="@Localizer["ClearLocationLabel"]">&times;</button>
                        <input type="hidden" asp-for="DestinationId" data-autocomplete-id />
                        <input type="hidden" asp-for="DestinationName" data-autocomplete-name />
                        <ul id="destinationAutocomplete-list" class="autocomplete__panel" role="listbox"
                            data-autocomplete-list hidden></ul>
                    </div>
                </div>
                <span asp-validation-for="DestinationId" class="field-error"></span>
            </div>

            <div class="search-bar__field search-bar__date @(dateInvalid ? "is-invalid" : null)">
                <div class="datepicker" data-datepicker data-min-date="@todayIso" data-date-label="@Localizer["DepartureDateLabel"]">
                    <span class="search-bar__label" id="departureDateLabel">@Localizer["DepartureDateLabel"]</span>
                    <button type="button" class="datepicker__trigger" data-datepicker-trigger
                            aria-haspopup="dialog" aria-expanded="false" aria-controls="departureDatePopover"
                            aria-labelledby="departureDateLabel">
                        <svg class="datepicker__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="4" y="5.5" width="16" height="14" rx="2.5" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M8 3.75v3M16 3.75v3M4 10h16"
                                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <span class="datepicker__weekday" data-datepicker-weekday></span>
                        <span class="datepicker__value" data-datepicker-display></span>
                    </button>
                    <input type="hidden" asp-for="DepartureDate" asp-format="{0:yyyy-MM-dd}" data-datepicker-value />
                    <div id="departureDatePopover" class="datepicker__popover" data-datepicker-popover hidden role="dialog"
                         aria-label="@Localizer["DatePickerLabel"]">
                        <div class="datepicker__nav">
                            <button type="button" class="datepicker__nav-btn" data-datepicker-prev aria-label="@Localizer["DatePickerPreviousMonth"]">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M14.5 5.5 8.5 12l6 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                            <div class="datepicker__month" data-datepicker-month-label></div>
                            <button type="button" class="datepicker__nav-btn" data-datepicker-next aria-label="@Localizer["DatePickerNextMonth"]">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M9.5 5.5 15.5 12l-6 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                        <div class="datepicker__weekdays" data-datepicker-weekdays aria-hidden="true"></div>
                        <div class="datepicker__grid" role="grid" data-datepicker-grid></div>
                    </div>
                </div>
                <span asp-validation-for="DepartureDate" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary search-bar__submit">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.5"/>
                    <path d="m16.2 16.2 3.3 3.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                @Localizer["SearchButton"]
            </button>
        </div>

        <div class="search-quick">
            <button type="button" class="chip" data-quick-date="today">@Localizer["TodayLabel"]</button>
            <button type="button" class="chip" data-quick-date="tomorrow">@Localizer["TomorrowLabel"]</button>
        </div>
    </form>
</section>

<section class="recent-searches" id="recentSearches" data-recent-searches hidden aria-label="@Localizer["RecentSearchesTitle"]">
    <p class="recent-searches__label">@Localizer["RecentSearchesTitle"]</p>
    <ul class="recent-searches__list" data-recent-searches-list></ul>
</section>

@section Scripts {
    <script src="~/js/datepicker.js" asp-append-version="true" defer></script>
    <script src="~/js/search-form.js" asp-append-version="true" defer></script>
}
