<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\oBiletCase.Application\oBiletCase.Application.csproj" />
    <ProjectReference Include="..\oBiletCase.Domain\oBiletCase.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure'ın internal sınıflarının (ör. ObiletApiClient) gerçek
         API'ye bağımlı olmayan mock/fake tabanlı testlerle doğrulanabilmesi için. -->
